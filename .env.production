# ==========================================
# Production Environment Configuration
# Automatically loaded by Vite during `vite build`
# ==========================================

# Backend API proxy target
BACKEND_URL=http://172.20.204.223:8080

# Production API Base URL
# - Keep EMPTY ("") when hosted on IIS using Reverse Proxy (web.config rewrites /api/* to the backend).
# - Set full URL (e.g., http://172.20.204.223:8080) only if making direct cross-origin CORS requests.
VITE_API_BASE_URL=

# Live Stream / SSE URL override (optional, defaults to `${API_BASE_URL}/api/liveCheck`)
# VITE_LIVE_CHECK_URL=

# TeCMi Vyapti Retail Suite redirection destination on logout
VITE_VYAPTI_LOGOUT_URL=http://172.20.204.118/VYAPTI_RETAIL_SUITE/index.aspx
